[Unit]
Description=Solar Vision Telegram Bot
After=network.target

[Service]
User=vasi
EnvironmentFile=/etc/solar-monitor/production.env
WorkingDirectory=/home/vasi/Escritorio/vision/software/vision/src
ExecStart=/home/vasi/Escritorio/vision/venv/bin/python /home/vasi/Escritorio/vision/software/vision/src/telegram_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
